rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only people signed in with an account you created (Firebase Console →
    // Authentication → Users) can read or write. There's no Google account and no
    // domain check here — access is controlled entirely by which logins you've created.
    match /app/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
